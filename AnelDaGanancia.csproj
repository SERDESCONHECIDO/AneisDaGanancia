<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableHarmony>true</EnableHarmony>
  </PropertyGroup>

  <ItemGroup>
    <!-- O nome correto do arquivo principal é "Stardew Valley.dll", com espaço -->
    <Reference Include="Stardew Valley">
      <HintPath>$(HOME)/StardewValley/Stardew Valley.dll</HintPath>
    </Reference>

    <!-- Referências que ficam na raiz do repositório clonado -->
    <Reference Include="StardewModdingAPI">
      <HintPath>$(HOME)/StardewValley/StardewModdingAPI.dll</HintPath>
    </Reference>
    <Reference Include="StardewValley.GameData">
      <HintPath>$(HOME)/StardewValley/StardewValley.GameData.dll</HintPath>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(HOME)/StardewValley/MonoGame.Framework.dll</HintPath>
    </Reference>

    <!-- O 0Harmony.dll fica dentro da subpasta "smapi-internal" -->
    <Reference Include="0Harmony">
      <HintPath>$(HOME)/StardewValley/smapi-internal/0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>